# NVIDIA — get from build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxx

# Finnhub — get from finnhub.io (free tier, 60 calls/min)
FINNHUB_API_KEY=xxxxx

# NewsAPI — get from newsapi.org (free tier, 100 req/day)
NEWSAPI_KEY=xxxxx

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=xxxxx
# Get chat ID by messaging the bot then hitting: GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=xxxxx

# Agent config
WATCHLIST=NVDA,MSFT,GOOGL,AAPL,META
MOVEMENT_THRESHOLD_PCT=2.0
HEARTBEAT_INTERVAL_MINUTES=5
