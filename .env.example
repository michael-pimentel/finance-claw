# NVIDIA NIM — required to run the OpenClaw agent
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Finnhub — required for real-time price data and news
# Free tier: 60 calls/min | https://finnhub.io
FINNHUB_API_KEY=your-finnhub-key

# NewsAPI — optional, fallback news source
# newsapi.org (alphanumeric key) or newsapi.ai (UUID format)
NEWSAPI_KEY=your-newsapi-key-optional

# Telegram — optional, required for live alerts
# Create bot via @BotFather, get chat ID from getUpdates endpoint
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Slack — optional, alternative alert channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Agent config
WATCHLIST=NVDA,TSLA,AAPL,SPY,BTC-USD
MOVEMENT_THRESHOLD_PCT=2.0
HEARTBEAT_INTERVAL_MINUTES=5
