# NVIDIA NIM — required to run the Nemotron model
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Telegram — required for live alerts
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat ID by messaging the bot then visiting:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Brave Search — optional, improves web_search quality
# Without this, DuckDuckGo is used automatically (no key needed)
# Get from: https://api.search.brave.com
BRAVE_API_KEY=optional-better-search-results

# Agent config
WATCHLIST=NVDA,TSLA,AAPL,SPY,BTC-USD
MOVEMENT_THRESHOLD_PCT=2.0
HEARTBEAT_INTERVAL_MINUTES=10
